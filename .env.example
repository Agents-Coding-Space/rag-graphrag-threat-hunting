# Copy to .env locally; choose a provider/model suitable for your deployment.
# Never put real credentials in this example or in the handover ZIP.
# Supported providers: generic_openai, openai, ollama.
#
# ============================ PIN IMPACT ============================
# A "runtime pin" (outputs/final/*/runtime_pin.json) freezes the exact
# provider/model/config + code hashes used to produce a reported result.
#   * LLM_* / OLLAMA_*  -> AFFECT the pin. Changing them without a new pin
#                          makes the frozen study fail verification.
#   * RUN_* / VALIDATOR_* -> DO NOT affect the pin (operational parameters:
#                          pacing, attempt budget, validator scan window).
# Dataset/benchmark paths and gate policy stay in configs/evaluation/*.json:
# they identify the experiment, they are not runtime knobs.
# ====================================================================
LLM_PROVIDER=generic_openai
LLM_MODEL=replace-with-model-id
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_API_KEY=
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=120
# The current comparison harness uses a single HTTP attempt per generation.
LLM_MAX_RETRIES=1
LLM_RETRY_DELAY=2.0
# Used when LLM_PROVIDER=ollama; /v1 is appended by LLMConfig.
OLLAMA_HOST=http://localhost:11434
OLLAMA_API_KEY=

# === THỰC NGHIỆM (không ảnh hưởng pin) ===
# Pacing tối thiểu (giây) giữa hai lần gọi LLM; env override giá trị
# final_run_policy trong config JSON khi được set (hợp lệ, > 0).
RUN_REQUEST_INTERVAL_SECONDS=
# Ngân sách attempt: initial (lượt đầu) / recovery (lỗi dịch vụ) / tổng.
RUN_INITIAL_ATTEMPT_LIMIT=
RUN_RECOVERY_ATTEMPT_LIMIT=
RUN_TOTAL_ATTEMPT_LIMIT=

# === VALIDATOR (không ảnh hưởng pin) ===
# Cửa sổ ký tự (look-behind/look-ahead) quanh chủ đề network
# (C2/HTTP/exfiltration) để dò phủ định => phân biệt boundary caveat với
# claim ngoài phạm vi được hỏi. Bỏ trống -> mặc định 120/80. Giá trị hỏng
# hoặc <= 0 cũng fallback về mặc định.
VALIDATOR_NETWORK_LOOKBEHIND=
VALIDATOR_NETWORK_LOOKAHEAD=
